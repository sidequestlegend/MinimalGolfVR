{
  "name": "mini-golf-rules",
  "version": "0.0.0",
  "private": true,
  "description": "The rules of mini-golf (a multiplayer port of dilmerv/MinimalGolfVR, MIT) on the portkit runtime. portkit/ is a copy of the shared kit (tools/sync.sh).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node --disable-warning=ExperimentalWarning portkit/tools/lint.ts src portkit/src",
    "unit": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "test": "npm run typecheck && npm run lint && npm run unit",
    "build": "node --disable-warning=ExperimentalWarning portkit/tools/build.ts --game . --out ../Assets/WebRoot",
    "levels": "node --disable-warning=ExperimentalWarning tools/levels-from-port.ts",
    "golden": "dotnet run --project golden -c Release -- vectors/upstream.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
